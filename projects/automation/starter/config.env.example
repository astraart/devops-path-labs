# Настройки server-automation. install.sh копирует этот файл в /etc/server-automation/config.env
# только при первой установке. Формат — KEY=VALUE, как у EnvironmentFile в systemd: без пробелов
# вокруг «=», значения со списками — в кавычках. Секреты сюда не кладите: файл попадёт в git.

# Что архивировать: пути через пробел.
BACKUP_SOURCES="/etc"
# Куда складывать архивы и сколько последних хранить.
BACKUP_DIR=/var/backups/server-automation
KEEP=7

# Что проверять: адреса через пробел, таймаут на один запрос в секундах, порог заполнения диска.
HEALTH_URLS="http://localhost/"
HEALTH_TIMEOUT=5
DISK_MAX_PERCENT=90

# Где хранить результат проверок (health.json) и отчёты (STATE_DIR/reports).
STATE_DIR=/var/lib/server-automation
